# Every pinned version, in one place. Component scripts read these and never
# hard-code a version. After changing a value, run:
#   ./setup.sh status          # shows which components are now out of date
#   ./setup.sh <component>     # re-installs it with the new version

# --- NVIDIA Dynamo + vLLM (one virtual environment, components/dynamo.sh) -----
# pip installs ai-dynamo[vllm]==DYNAMO_VERSION. That package pins its vLLM
# (ai-dynamo 1.6.1 -> vllm==0.31.0, nixl 1.4.1), so DYNAMO_VLLM_VERSION must be
# the version Dynamo pins: check PyPI ("Requires: vllm==...") when you bump
# DYNAMO_VERSION. `./setup.sh verify dynamo` fails if they disagree.
DYNAMO_VERSION="1.6.1"
DYNAMO_VLLM_VERSION="0.31.0"
CUDA_VARIANT="cu130"     # PyTorch/vLLM wheel build; the AMI driver must support it (nvidia-smi)
PYTHON_VERSION="3.12"

# --- Container image (optional SOCI experiment only, bench/soci-pull.sh) ------
# Serving does not use containers. This image is what the SOCI pull benchmark
# pulls: NVIDIA's Dynamo vLLM runtime for the same Dynamo release.
SOCI_TEST_IMAGE="nvcr.io/nvidia/ai-dynamo/vllm-runtime:1.6.1@sha256:5899e7bdd3528ab09a17ec87e2abe1949f8a0386a0a49f3b24dbd52d8211dc5d"
