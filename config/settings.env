# Settings shared by the components, run/ and bench/ scripts. Everything that
# is not a version lives here. Values can be overridden for one run from the
# environment, for example:  WORKERS=4 ./run/dynamo.sh up
#
# Local, git-ignored overrides (for example HF_TOKEN) go in config/local.env.

# --- Storage layout (created by provision/user-data.sh) ----------------------
DATA_DIR="${DATA_DIR:-/data}"            # EBS volume (persists while the volume exists)
SCRATCH_DIR="${SCRATCH_DIR:-/scratch}"   # instance-store NVMe RAID0 (fast, wiped on stop/start)

# --- Models -----------------------------------------------------------------
# Downloaded from Hugging Face on every new instance into the NVMe RAID0.
MODEL="${MODEL:-Qwen/Qwen3-30B-A3B}"     # served by run/dynamo.sh
MODELS="${MODELS:-${MODEL}}"             # downloaded by ./setup.sh models (space separated)
MODEL_CACHE_DIR="${MODEL_CACHE_DIR:-${SCRATCH_DIR}/hf}"  # Hugging Face cache (HF_HOME of the workers)
HF_TOKEN="${HF_TOKEN:-}"                 # optional; higher download rate limits (set in config/local.env)

# --- Dynamo serving on this instance (run/dynamo.sh) -------------------------
WORKERS="${WORKERS:-8}"                  # vLLM workers, one GPU each (p5en: up to 8)
ROUTER_MODE="${ROUTER_MODE:-round-robin}" # round-robin | kv | random | least-loaded | ...
HTTP_PORT="${HTTP_PORT:-8000}"           # OpenAI-compatible frontend
MAX_MODEL_LEN="${MAX_MODEL_LEN:-}"       # empty = model default
WORKER_EXTRA_ARGS="${WORKER_EXTRA_ARGS:-}" # extra vLLM engine args for every worker
# Per-worker ports are BASE + worker index (0..WORKERS-1).
WORKER_SYSTEM_PORT_BASE="${WORKER_SYSTEM_PORT_BASE:-8081}"   # health/metrics (DYN_SYSTEM_PORT)
WORKER_KV_EVENTS_PORT_BASE="${WORKER_KV_EVENTS_PORT_BASE:-20080}" # ZMQ KV events (ROUTER_MODE=kv)
WORKER_NIXL_PORT_BASE="${WORKER_NIXL_PORT_BASE:-20100}"      # VLLM_NIXL_SIDE_CHANNEL_PORT
# Single host: workers and frontend find each other through files in a
# shared directory (no etcd, no NATS). Logs and process IDs go here too.
DYNAMO_STATE_DIR="${DYNAMO_STATE_DIR:-${SCRATCH_DIR}/dynamo}"

# --- Dynamo + vLLM virtual environment (components/dynamo.sh) ---------------
# On /data, next to uv's package cache, so uv clones files instead of copying.
DYNAMO_VENV="${DYNAMO_VENV:-${DATA_DIR}/venvs/dynamo}"

# --- Containers (optional SOCI experiment only) ------------------------------
# nerdctl talks to containerd, which uses the SOCI snapshotter (components/soci.sh).
NERDCTL="${NERDCTL:-sudo nerdctl}"

# --- Claude Code on Amazon Bedrock (optional component) ----------------------
CLAUDE_OPUS_MODEL="${CLAUDE_OPUS_MODEL:-us.anthropic.claude-opus-5-5}"
CLAUDE_HAIKU_MODEL="${CLAUDE_HAIKU_MODEL:-us.anthropic.claude-haiku-4-5-20251001-v1:0}"
CLAUDE_FABLE_MODEL="${CLAUDE_FABLE_MODEL:-us.anthropic.claude-fable-5-2}"
